# -----------------------------------------------------------------------
# Argus ANPR — Environment Configuration Template
# Copy this file to .env and fill in the values for your deployment.
# Keys without a default are REQUIRED for the associated provider to work.
# -----------------------------------------------------------------------

# ── Provider Selection ──────────────────────────────────────────────────
# Which provider to try first in the waterfall.
# Options: paddleocr | nvidia | platerecognizer
# DEFAULT_PROVIDER=paddleocr

# ── PlateRecognizer Cloud API ───────────────────────────────────────────
# Required only when using the "platerecognizer" provider.
# Obtain at: https://platerecognizer.com
# PLATE_RECOGNIZER_TOKEN=

# ── NVIDIA Vision API (Llama-3.2-11B) ──────────────────────────────────
# Required only when using the "nvidia" provider.
# At least one of the three keys below must be set.
# Obtain at: https://build.nvidia.com
# NVIDIA_API_KEY=
# LLAMA_API_KEY=
# NEMOTRON_API_KEY=

# NVIDIA_INVOKE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# ── YOLO Model ──────────────────────────────────────────────────────────
# YOLO_MODEL_NAME=yolo11n.pt
# YOLO_CONFIG_DIR=.cache/ultralytics

# ── PaddleOCR Tuning ────────────────────────────────────────────────────
# PADDLE_CPU_THREADS=4
# PADDLE_USE_ANGLE_CLS=true

# ── Upload / Safety Limits ──────────────────────────────────────────────
# MAX_UPLOAD_BYTES=8388608       # 8 MB raw upload ceiling
# MAX_IMAGE_PIXELS=50000000      # decompression-bomb guard (width × height)
# MAX_IMAGE_EDGE_PX=1920         # longest edge after downscaling

# ── Pipeline Bounds (NASA rule 2) ───────────────────────────────────────
# MAX_VEHICLE_BOXES=3            # YOLO boxes examined per frame
# MAX_OCR_LINES=40               # PaddleOCR text lines examined per crop

# ── Outbound HTTP Timeouts (seconds) ────────────────────────────────────
# HTTP_CONNECT_TIMEOUT=3.0
# HTTP_READ_TIMEOUT=10.0

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. "*" is appropriate for a
# weighbridge microservice with no browser clients, but tighten for
# any public-facing deployment.
# ALLOWED_ORIGINS=["*"]
