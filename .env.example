YOLO_MODEL_NAME=yolo11n.pt
YOLO_CONFIG_DIR=/tmp/Ultralytics
HUMAN_CONF_THRESH=0.30
VEHICLE_CONF_THRESH=0.35
REJECT_ON_HUMAN_DETECTED=true
MAX_ALLOWED_HUMANS=0
REJECT_ON_MULTIPLE_VEHICLES=true
MAX_ALLOWED_VEHICLES=1
REJECT_ON_NO_VEHICLE=true
MIN_ALLOWED_VEHICLES=1
MIN_HUMAN_BOX_AREA_RATIO=0.005
MIN_VEHICLE_BOX_AREA_RATIO=0.01
MAX_CONCURRENT_INFERENCES=4
